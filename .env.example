# Copy this file to .env.local and fill in the values.

# Google AI Studio -> Get API key (https://aistudio.google.com)
GOOGLE_GENERATIVE_AI_API_KEY=

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
# The "publishable" key (or the legacy "anon" key). Safe to expose; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: comma-separated origins allowed to call /api/v1 from a browser (e.g. a separate web app).
# Mobile and server apps don't need this. Leave empty to allow none, or "*" for any.
API_ALLOWED_ORIGINS=

# Optional: max messages per user per minute (default 15).
RATE_LIMIT_PER_MINUTE=15
