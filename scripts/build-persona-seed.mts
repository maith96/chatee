// Validates personas/*.json against the character-sheet schema and writes supabase/personas-seed.sql.
// Run: npm run personas:seed   (then paste the SQL into the Supabase SQL Editor)
import { readdirSync, readFileSync, writeFileSync } from "node:fs";
import { join } from "node:path";
import { personaInputSchema } from "../src/lib/persona-schema.ts";

const dir = join(import.meta.dirname, "..", "personas");
const files = readdirSync(dir).filter((f) => f.endsWith(".json")).sort();
const sqlString = (s: string | null | undefined) => (s == null ? "null" : `'${s.replace(/'/g, "''")}'`);

let failed = false;
const rows: string[] = [];
for (const file of files) {
  const raw = JSON.parse(readFileSync(join(dir, file), "utf8"));
  const slug: unknown = raw.slug;
  const parsed = personaInputSchema.safeParse(raw);
  if (typeof slug !== "string" || !/^[a-z0-9-]+$/.test(slug)) {
    console.error(`✗ ${file}: "slug" must be lowercase letters, numbers or dashes`);
    failed = true;
    continue;
  }
  if (!parsed.success) {
    console.error(`✗ ${file}:`);
    for (const issue of parsed.error.issues) console.error(`   ${issue.path.join(".")}: ${issue.message}`);
    failed = true;
    continue;
  }
  const p = parsed.data;
  rows.push(
    `  (${sqlString(slug)}, ${sqlString(p.name)}, ${sqlString(p.tagline)}, ${sqlString(p.avatar_emoji)}, ` +
      `${sqlString(p.avatar_url)}, ${sqlString(p.visibility)}, ${sqlString(JSON.stringify(p.definition))}::jsonb)`,
  );
  console.log(`✓ ${file}`);
}
if (failed) process.exit(1);

const sql = `-- Built-in personas. GENERATED by scripts/build-persona-seed.ts from personas/*.json. Don't edit by hand.
-- Safe to re-run: updates existing built-in personas in place.
insert into public.personas (slug, name, tagline, avatar_emoji, avatar_url, visibility, definition)
values
${rows.join(",\n")}
on conflict (slug) where owner_id is null do update set
  name = excluded.name,
  tagline = excluded.tagline,
  avatar_emoji = excluded.avatar_emoji,
  avatar_url = excluded.avatar_url,
  visibility = excluded.visibility,
  definition = excluded.definition,
  updated_at = now();
`;
writeFileSync(join(import.meta.dirname, "..", "supabase", "personas-seed.sql"), sql);
console.log(`Wrote supabase/personas-seed.sql (${rows.length} personas)`);
